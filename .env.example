# Environment Variables
# Copy this file to .env and update values as needed

# API Configuration (uses Vite proxy `/api` in dev)
VITE_API_URL=/api

# Analytics
VITE_ANALYTICS_ID=

# WhatsApp Integration
VITE_WHATSAPP_NUMBER=919979883339

# Third-party Services
VITE_MAPS_API_KEY=

# Supabase — required for login, signup, bookings & admin features.
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Required for admin booking status synchronization and privileged backend operations.
# Never prefix this with VITE_ or expose it to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional but required for searchable image-only scanned PDFs.
# Install English Tesseract traineddata locally and point this at its containing folder.
# Example (Windows): TESSERACT_LANG_PATH=C:\\tools\\tesseract\\tessdata
# Example (Linux/container): TESSERACT_LANG_PATH=/usr/share/tesseract-ocr/5/tessdata
TESSERACT_LANG=eng
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=

